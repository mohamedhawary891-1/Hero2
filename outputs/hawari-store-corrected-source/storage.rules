rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isStoreAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'mohamedhawary891@gmail.com' ||
        request.auth.token.email == 'admin@hawaristore.com' ||
        request.auth.token.email == 'hawary@hawaristore.com' ||
        request.auth.token.admin == true
      );
    }

    // 1. Cover Images: Public read, Admin-only write (Max 25MB).
    // This matches validateCoverImageFile in src/services/firebase.ts.
    match /covers/{coverId} {
      allow read: if true;
      allow write: if isStoreAdmin() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isStoreAdmin();
    }

    // 2. Book PDFs & Digital Documents: Admin-only upload/delete (Max 50MB)
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow write: if isStoreAdmin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isStoreAdmin();
    }

    // 3. Payment Transfer Screenshots & Receipts (Max 15MB)
    match /receipts/{receiptId} {
      allow create: if request.resource.size < 15 * 1024 * 1024;
      allow read, delete: if isStoreAdmin();
    }
  }
}
